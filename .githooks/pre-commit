#!/bin/sh
# Refuse a commit whose tests are red.
#
# This exists because it has happened twice. Once by reading a grep exit code
# instead of a test exit code -- grep returns 0 because it FOUND the "# fail"
# line -- and once by running `npm test` as its own statement so the `&&` that
# followed never saw its status. Both times the commit landed green-looking and
# red. Intent is not a mechanism; this is.
#
# Tests and lint only. The full guard runs several suites and takes far too
# long to sit in front of every commit, which is how a hook gets disabled.
#
# Install:  git config core.hooksPath .githooks
# Bypass:   git commit --no-verify   (say why in the message)
set -e

# FIRST, and before the slow checks. scripts/precommit.ts scans the STAGED
# content for credentials and for dangerous commands inside the corpus, and it
# is the last moment before a leak becomes permanent and public.
#
# It was written, tested, and then wired to nothing: this hook ran tests,
# typecheck and corpus lint, and lint-corpus.ts calls scanExecutable but not
# scanSensitive. So the one gate whose whole job was to stop a credential
# entering git history was not in the path of a single commit. Found while
# clearing out orphaned scripts -- `scripts/precommit.ts` was referenced by
# nothing, which is what an unwired safety gate looks like from the outside.
#
# It runs before `npm test` so a leak is refused in a second rather than after
# thirty-five, and because a gate people wait for is a gate people bypass.
echo "pre-commit: staged content"
npx tsx scripts/precommit.ts || exit 1

echo "pre-commit: tests"
npm test >/tmp/cairn-precommit.log 2>&1 || {
  echo "REFUSED — tests are red:"
  grep -E "^not ok|^# (pass|fail)" /tmp/cairn-precommit.log | head -20
  echo "  full output: /tmp/cairn-precommit.log"
  exit 1
}

echo "pre-commit: typecheck"
npx tsc --noEmit -p tsconfig.json >/tmp/cairn-precommit-tsc.log 2>&1 || {
  echo "REFUSED — typecheck errors:"
  head -10 /tmp/cairn-precommit-tsc.log
  exit 1
}

echo "pre-commit: corpus lint"
npx tsx scripts/lint-corpus.ts >/tmp/cairn-precommit-lint.log 2>&1 || true
if grep -qE "^error" /tmp/cairn-precommit-lint.log; then
  echo "REFUSED — corpus lint errors:"
  grep -E "^error" /tmp/cairn-precommit-lint.log | head -10
  exit 1
fi

echo "pre-commit: ok"
