generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id                 String   @id @default(cuid())
  name               String   @unique
  avatarColor        String
  owner              String   @default("")
  ownerVerified      Boolean  @default(false)
  verificationMethod String?  // 'twitter' | 'domain' | null
  verificationProof  String?  // DNS TXT record value or tweet URL
  entity             String   @default("")
  bio                String
  skills             Json     @default("[]")        // AgentSkill[]
  categories         Json     @default("[]")        // string[]
  rateLimits         String   @default("")
  availability       String   @default("")
  tasksCompleted     Int      @default(0)
  successRate        Float    @default(0)
  avgResponseTime    Float    @default(0)
  uptime30d          Float    @default(0)
  joinDate           DateTime @default(now())
  peerReviews        Json     @default("[]")        // { agentId, agentName, rating, comment }[]
  endpoint           String
  protocols          Json     @default("[]")        // string[]
  authMethod         String   @default("")
  payloadFormat      String   @default("application/json")
  status             String   @default("online")    // 'online' | 'offline' | 'busy'
  lastSeen           DateTime @default(now())
  credits            Float    @default(0)
  price              Float?
  walletAddress      String?
  reputationScore    Int      @default(0)
  trustTier          String   @default("unverified") // unverified | verified | trusted | enterprise
  securityPolicy     Json?    // { dataRetention, encryption, auditLog, compliance[] }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  listings         Listing[]
  sentMessages     DirectMessage[] @relation("SentMessages")
  receivedMessages DirectMessage[] @relation("ReceivedMessages")
  fromHandoffs     Handoff[]       @relation("FromHandoffs")
  toHandoffs       Handoff[]       @relation("ToHandoffs")
  transactionsFrom Transaction[]   @relation("TransactionsFrom")
  transactionsTo   Transaction[]   @relation("TransactionsTo")
  apiKeys          ApiKey[]
  auditLogs        AuditLog[]
  agentRoles       AgentRole[]
  memories         Memory[]
}

model Listing {
  id            String   @id @default(cuid())
  agentId       String
  agentName     String
  section       String   // 'services' | 'gigs' | 'data' | 'tools' | 'partnerships' | 'discussion'
  title         String
  description   String
  endpoint      String   @default("")
  categories    Json     @default("[]") // string[]
  price         Float?
  transactionId String?
  parentId      String?
  parentTitle   String?

  createdAt DateTime @default(now())

  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  parent  Listing? @relation("ThreadReplies", fields: [parentId], references: [id])
  replies Listing[] @relation("ThreadReplies")
}

model DMChannel {
  id         String   @id @default(cuid())
  agent1Id   String
  agent1Name String
  agent2Id   String
  agent2Name String

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  messages DirectMessage[]
  handoffs Handoff[]
}

model DirectMessage {
  id            String   @id @default(cuid())
  channelId     String
  fromAgentId   String
  fromAgentName String
  toAgentId     String
  toAgentName   String
  message       String
  payload       Json?    // HandoffPayload | null

  timestamp DateTime @default(now())

  channel   DMChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  fromAgent Agent     @relation("SentMessages", fields: [fromAgentId], references: [id])
  toAgent   Agent     @relation("ReceivedMessages", fields: [toAgentId], references: [id])
}

model Handoff {
  id            String   @id @default(cuid())
  fromAgentId   String
  fromAgentName String
  toAgentId     String
  toAgentName   String
  channelId     String
  status        String   @default("proposed") // proposed|accepted|in_progress|delivered|completed|rejected
  task          Json     // { title, description, inputFormat, outputFormat }
  result        Json?    // { format, content, metadata }
  rating        Int?     // 1-5 stars from the requester
  review        String?  // Optional review text
  price         Float?
  transactionId String?
  deliveredAt   DateTime?
  completedAt   DateTime?
  // Security
  securityTier    String  @default("standard") // standard | sensitive | confidential
  dataPolicy      Json?   // { retention, deleteOnComplete, encryption, audit }
  requiredTrust   String  @default("unverified") // min trust tier the worker must have
  auditLog        Json    @default("[]") // [{ action, agentId, timestamp, ip? }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel   DMChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  fromAgent Agent     @relation("FromHandoffs", fields: [fromAgentId], references: [id])
  toAgent   Agent     @relation("ToHandoffs", fields: [toAgentId], references: [id])
}

model Transaction {
  id              String   @id @default(cuid())
  type            String   // 'handoff_payment' | 'listing_purchase' | 'bonus' | 'refund' | 'deposit'
  amount          Float
  fromAgentId     String?
  toAgentId       String?
  referenceId     String?
  referenceType   String?  // 'handoff' | 'listing'
  description     String
  balanceAfterFrom Float?
  balanceAfterTo   Float?
  createdAt       DateTime @default(now())

  fromAgent Agent? @relation("TransactionsFrom", fields: [fromAgentId], references: [id])
  toAgent   Agent? @relation("TransactionsTo", fields: [toAgentId], references: [id])
}

model ApiKey {
  id         String    @id @default(cuid())
  agentId    String
  keyHash    String    @unique
  keyPrefix  String
  name       String    @default("default")
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  agentId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  agent Agent? @relation(fields: [agentId], references: [id])
}

// ─── Agent Memory System ─────────────────────────────────

model Memory {
  id        String   @id @default(cuid())
  agentId   String   // Which agent created this memory
  agentSlug String   // Role slug for fast filtering (e.g. "cfo", "client-care")
  type      String   @default("fact") // fact | decision | metric | client | pattern | preference
  content   String   // The actual memory content (curated, concise)
  tags      String[] // Searchable tags: ["mrr", "stripe", "march-2026"]
  source    String?  // What produced this: handoff ID, brief text, etc.
  importance Int     @default(5) // 1-10, higher = more important, affects retrieval priority
  expiresAt DateTime? // Optional TTL — some facts are time-sensitive

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentSlug])
  @@index([type])
  @@index([tags])
}

// Daily context log — append-only, like OpenClaw daily notes
model DailyNote {
  id        String   @id @default(cuid())
  date      String   // "2026-03-15"
  agentSlug String   // Which agent this note belongs to (or "system" for shared)
  entries   Json     @default("[]") // Array of { timestamp, content, handoffId?, type }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, agentSlug])
  @@index([agentSlug])
}

// ─── Agentcy System ─────────────────────────────────────

model AgentRole {
  id          String   @id @default(cuid())
  name        String   @unique  // "Chief of Staff", "Researcher", etc.
  slug        String   @unique  // "chief-of-staff", "researcher", etc.
  description String
  systemPrompt String  // The full system prompt that defines this agent's behavior
  model       String   @default("claude-sonnet-4-6") // Which Claude model to use
  agentId     String?  // Links to the Agent record in the network
  avatarColor String   @default("#6366f1")
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent? @relation(fields: [agentId], references: [id])
  assignedTasks Task[] @relation("AssignedToRole")
  createdTasks  Task[] @relation("CreatedByRole")
}

model Sprint {
  id        String   @id @default(cuid())
  name      String   // "Morning Brief - Mar 15" or user-defined
  brief     String   // The raw brief/instructions from the user
  status    String   @default("active") // active | completed | cancelled
  summary   String?  // End-of-sprint summary generated by Chief of Staff

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  tasks Task[]
}

model Task {
  id          String   @id @default(cuid())
  sprintId    String
  title       String
  description String
  status      String   @default("pending") // pending | in_progress | in_review | approved | rejected | revision
  priority    String   @default("medium")  // low | medium | high | urgent
  assignedTo  String?  // AgentRole slug
  createdBy   String?  // AgentRole slug that created this task (usually chief-of-staff)

  input       String?  // Input/context for the agent to work with
  output      String?  // The agent's response/deliverable
  qaFeedback  String?  // QA agent's review notes
  qaScore     Int?     // 1-5 quality score from QA

  tokenCount  Int      @default(0)
  costUsd     Float    @default(0)
  latencyMs   Int      @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  sprint      Sprint     @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  assignedRole AgentRole? @relation("AssignedToRole", fields: [assignedTo], references: [slug])
  createdByRole AgentRole? @relation("CreatedByRole", fields: [createdBy], references: [slug])
}

// ─── Support System ─────────────────────────────────────

model SupportTicket {
  id          String   @id @default(cuid())
  subject     String
  body        String
  status      String   @default("open") // open | pending | in_progress | resolved | closed
  priority    String   @default("medium") // critical | high | medium | low
  category    String?  // bug | feature_request | billing | account | how_to | security | other
  tags        String[] // e.g. ["login", "api", "urgent"]
  customerEmail String
  customerName  String?
  escalated   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?

  responses   TicketResponse[]

  @@index([status])
  @@index([priority])
  @@index([customerEmail])
}

model TicketResponse {
  id          String   @id @default(cuid())
  ticketId    String
  message     String
  isInternal  Boolean  @default(false) // internal note vs customer-facing
  isDraft     Boolean  @default(true)  // drafts need human approval before sending
  author      String   @default("agent") // "agent" | "human" | "customer"

  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model KBArticle {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String?
  tags        String[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Client Care / CRM System ───────────────────────────

model Client {
  id            String   @id @default(cuid())
  companyName   String   @unique
  status        String   @default("active") // active | onboarding | churned | paused
  plan          String?  // e.g. "growth", "enterprise", "starter"
  health        String   @default("healthy") // healthy | at_risk | critical
  healthScore   Int      @default(80) // 0-100
  mrr           Float    @default(0)
  contractStart DateTime?
  contractEnd   DateTime?
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts      ClientContact[]
  deliverables  Deliverable[]
  engagementLog EngagementEntry[]

  @@index([status])
  @@index([health])
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  email     String
  role      String?  // "CEO", "CTO", "PM", etc.
  isPrimary Boolean  @default(false)

  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Deliverable {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  description String?
  status      String   @default("pending") // pending | in_progress | delivered | approved | overdue
  dueDate     DateTime?
  deliveredAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
}

model EngagementEntry {
  id        String   @id @default(cuid())
  clientId  String
  type      String   // meeting | email | call | internal | action_item | concern
  content   String
  author    String   @default("agent") // who logged this

  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}
