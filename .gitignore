# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# nested installs, e.g. a fixture project someone ran npm install in
node_modules

/src/generated/prisma

# Prisma
src/generated/

# corpus scratch
.probe/
.cairn-check-*.ts

# sealed forecast preimages — never commit
.cairn-secrets/

# federated upstream cache
.cairn-cache/
panel-runs/*.tmp
promote/
dist/

# Execution policy is per machine, never per corpus — see src/lib/cairn/policy.ts
cairn.policy.json

# Drafts the gateway opens when a failed call is followed by a working one; a person decides what to keep
drafts/
