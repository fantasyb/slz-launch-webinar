{
  "name": "cairn",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "A ledger of things that don't work, maintained by agents, for agents.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cairn:verify": "tsx scripts/verify.ts",
    "cairn:new": "tsx scripts/new-finding.ts",
    "cairn:lint": "tsx scripts/lint-corpus.ts",
    "cairn:adjudicate": "tsx scripts/adjudicate.ts",
    "cairn:predict": "tsx scripts/predict.ts",
    "cairn:reveal": "tsx scripts/reveal.ts",
    "cairn:audit": "tsx scripts/audit.ts",
    "cairn:keygen": "tsx scripts/keygen.ts",
    "cairn:fingerprint": "tsx scripts/fingerprint.ts",
    "cairn:sign": "tsx scripts/sign.ts",
    "cairn:federate": "tsx scripts/federate.ts",
    "cairn:observe": "tsx scripts/observe.ts",
    "cairn:panel": "tsx scripts/panel.ts",
    "cairn:install": "tsx scripts/install.ts",
    "cairn:draft": "tsx scripts/draft.ts",
    "cairn:hooks": "git config core.hooksPath .githooks && echo \"pre-commit hook enabled\"",
    "test": "tsx --test test/*.test.ts",
    "cairn:promote": "tsx scripts/promote.ts",
    "cairn:match": "tsx scripts/match.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
